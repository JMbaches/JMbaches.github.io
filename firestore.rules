// ============================================================================
// MIROIR des règles Firestore déployées (projet `jm-baches`, via Firebase
// Console — le déploiement reste manuel, PAS `firebase deploy` depuis ce repo).
// Ce fichier sert de source pour les tests de règles (tests/firestore.rules.test.js).
// ⚠️ À RECOPIER ICI À CHAQUE MODIFICATION DES RÈGLES DANS LA CONSOLE, sinon les
// tests valident un ruleset obsolète. Récupéré en lecture seule le 2026-07-17
// via le service account (`firebase-admin/security-rules`).
// ============================================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------- Fonctions --------------------------------
    function signedIn() {
      return request.auth != null;
    }
    function meExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function active() {
      return meExists() && me().active == true;
    }
    function role() {
      return meExists() ? me().role : '';
    }
    function hasPerm(p) {
      return meExists() && (me().perms is list) && (p in me().perms);
    }
    function isDirection() {
      return role() == 'direction';
    }
    // ⚠️ [Fix 2026-08-04] 'vue_poseur' ajoute -- un poseur pur (perm par defaut ROLE_DEFAULT_PERMS.
    // poseur = ['vue_poseur'] uniquement) ne pouvait lire AUCUN dossier, donc l'onglet "Ma journee"
    // (renderVuePoseur, index.html -- filtre le tableau `dossiers` en memoire sur poseDate/poseurId)
    // restait vide en permanence : fonctionnalite prevue mais jamais reellement utilisable. Trouve
    // en lisant le code (pas un compte reel teste, la fonctionnalite n'a jamais ete signalee cassee
    // faute d'avoir jamais ete essayee avec un compte poseur pur).
    function canViewDossiers() {
      return hasPerm('view_all') || hasPerm('view_prod') || hasPerm('metreur')
          || hasPerm('emballage') || hasPerm('compta')   || hasPerm('planning')
          || hasPerm('vue_poseur');
    }
    function canEditDossiers() {
      return hasPerm('edit') || hasPerm('advance') || hasPerm('planning') || hasPerm('metreur')
          || ((hasPerm('adv_prod') || hasPerm('emballage')) && onlyAtelierOuEmballageFieldsChanged());
    }
    // Champs que l'atelier ET l'emballage (perms adv_prod/emballage SEULES, sans edit/advance/
    // planning/metreur -- donc sans effet sur les comptes qui ont aussi une de ces perms plus
    // larges, ex. direction) peuvent modifier sur un dossier -- whitelist etablie le 2026-08-04 en
    // lisant exhaustivement atelier.js ET emballage.js (toutes les affectations `d.xxx =`, y
    // compris via changerStatutDossier/logHistory, seule fonction partagee que ces deux fichiers
    // utilisent pour muter un dossier) : c'est la seule surface d'ecriture "dossiers" accessible a
    // un compte n'ayant NI edit/advance/planning/metreur. emballage.js ne touche en pratique QUE
    // statut/statutChangedAt/history (deja dans la whitelist atelier) -- pas de champ
    // supplementaire necessaire, d'ou le partage de la meme fonction plutot qu'une 2e whitelist.
    // Avant ce fix, un compte emballage SANS adv_prod (le cas par defaut d'un nouveau compte cree
    // via l'ecran de gestion) ne passait aucune des conditions ci-dessus et ne pouvait faire
    // avancer AUCUN dossier -- fonctionnalite cassee pour ce cas precis (le seul compte emballage
    // reel existant a aussi adv_prod, donc fonctionnait deja par ce biais).
    function onlyAtelierOuEmballageFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'statut', 'statutChangedAt', 'history',
        'atelierAccessoiresFait', 'atelierTablierFait', 'atelierAxeFait', 'pages'
      ]);
    }

    // -------------------------------- users ---------------------------------
    match /users/{uid} {
      // Lecture : TOUT utilisateur actif peut lire la liste
      // (nécessaire au démarrage — le layer charge toute la collection users)
      allow get, list: if active();

      // Création : gestionnaires de comptes UNIQUEMENT.
      // ⚠️ [Fix 2026-08-04] hasPerm('create') ("Créer des dossiers", sans rapport avec la
      // gestion de comptes) était inclus ici par erreur — admin/commercial/sav l'ont tous par
      // défaut sans avoir 'users'. L'UI (users.js) ne montre l'écran de création de compte que
      // si can('users'), mais cette règle autorisait n'importe quel compte avec 'create' à
      // appeler l'API Firestore directement pour créer un compte 'direction' avec tous les
      // droits — escalade de privilèges complète. Aucun flux légitime ne dépend de 'create' ici.
      allow create: if active() && hasPerm('users');

      // Suppression : gestionnaires de comptes uniquement
      allow delete: if active() && hasPerm('users');

      // Mise à jour :
      //   • gestionnaires de comptes → tout champ
      //   • un utilisateur peut modifier SON profil MAIS pas role/perms/active
      allow update: if active() && (
        hasPerm('users') || (
          request.auth.uid == uid
          && request.resource.data.role   == resource.data.role
          && request.resource.data.perms  == resource.data.perms
          && request.resource.data.active == resource.data.active
        )
      );
    }

    // ------------------------------ dossiers --------------------------------
    match /dossiers/{id} {
      allow read:   if active() && canViewDossiers();
      allow create: if active() && hasPerm('create');
      allow update: if active() && canEditDossiers();
      allow delete: if active() && (isDirection() || hasPerm('users'));
    }

    // ---------------------------- notifications -----------------------------
  match /notifications/{id} {
  allow read:   if active();
  allow create: if active();
  allow update: if active() &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
    request.resource.data.read.diff(resource.data.read).affectedKeys().hasOnly([request.auth.uid]);
  allow delete: if active() && (isDirection() || hasPerm('users'));
}

    // -------- messagerie (collection plate avec champ convId) ---------------
    match /messages/{mid} {
      function estMembreConv(convId) {
        return convId == 'general' || request.auth.uid in convId.split('_');
      }
      allow read:   if active() && estMembreConv(resource.data.convId);
      allow create: if active() && estMembreConv(request.resource.data.convId) && request.resource.data.from == request.auth.uid;
      // ⚠️ [Fix 2026-08-04] L'ancienne règle update (auteur OU direction, SANS restriction de
      // champ) autorisait l'auteur d'un message à modifier N'IMPORTE QUEL champ après création —
      // y compris `convId` (vers une conversation privée dont il n'est pas membre) et `from`
      // (usurpation d'un autre utilisateur), sans jamais revérifier estMembreConv() au moment de
      // l'update. chat.js n'utilise pourtant .update() QUE pour ajouter son propre uid à `readBy`
      // (arrayUnion, jamais d'autre champ) — d'où la whitelist stricte ci-dessous, même schéma
      // que la règle notifications déjà en place juste au-dessus dans ce fichier. Corrige aussi
      // un vrai bug fonctionnel au passage : l'ancienne règle exigeait resource.data.from ==
      // request.auth.uid pour TOUT update, donc marquer "lu" le message d'un AUTRE échouait
      // silencieusement (chat.js:96, .catch(()=>{})) pour tout non-auteur/non-direction — cassé
      // en pratique pour la quasi-totalité des messages reçus.
      allow update: if active() && estMembreConv(resource.data.convId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      allow delete: if active() && (resource.data.from == request.auth.uid || isDirection());
    }

    // -------- meta (config partagée : horaires, etc.) -----------------------
    match /meta/{doc} {
      allow read:  if active();
      allow write: if active() && (hasPerm('horaires_poseurs') || isDirection());
    }

    match /poseur_hours/{userId} {
      allow read: if active() && (request.auth.uid == userId || hasPerm('horaires_poseurs') || isDirection());
      allow write: if active() && request.auth.uid == userId;
    }

// ------------------------------- stock (lames) ---------------------------
match /stock_refs/{codeBarre} {
  allow read, write: if active() && hasPerm('stock');
}

match /stock_mouvements/{mid} {
  allow read, create: if active() && hasPerm('stock');
  allow update, delete: if false; // historique immuable, jamais modifié
}

match /config/{id} {
  allow read: if active();
  allow write: if active() && hasPerm('stock');
}

    // -------------- Tout le reste : ACCÈS REFUSÉ par défaut -----------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
